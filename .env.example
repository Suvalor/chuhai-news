# 复制为 .env 后填写。生成随机值：openssl rand -hex 24
ADMIN_PASSWORD=
WEBHOOK_SECRET=
# 可选：MCP 写入工具的独立令牌，不设则沿用 WEBHOOK_SECRET
MCP_WRITE_TOKEN=
SECRET_KEY=
SITE_URL=https://你的域名
# 关于页公开的删除/更正联系邮箱；不设则关于页不显示联系方式
CONTACT_EMAIL=
# 可选：真实编辑署名、领域背景与公开社交/个人主页（公开显示，不填不虚构）
EDITOR_NAME=
EDITOR_BIO=
EDITOR_URL=
# IndexNow 密钥（8–128 位字母数字或 -，可用 openssl rand -hex 16 生成）；设置后发布、修改、下架会通知 Bing 等搜索引擎
INDEXNOW_KEY=
# DeepSeek：站点用它处理 WebHook 推来的链接（翻译、导读、类目），不设则链接导入返回 503；本地脚本 scripts/import_x.py 也用它
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# GEO Monitor: no paid requests by default. Enable only after verified cost pilot.
GEO_ENABLED=0
GEO_MAX_USD=0
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
GEO_OPENAI_MODEL=gpt-6.2-astra
GEO_GEMINI_MODEL=gemini-2.5-flash
# Empty means Perplexity Agent API fast effort.
GEO_PERPLEXITY_MODEL=
GEO_XAI_MODEL=grok-4.7
# Conservative per-attempt reservation in USD, including search/tool charges.
# Missing/nonpositive reservation disables that provider. Do not guess prices.
GEO_CHATGPT_CALL_USD=0
GEO_GEMINI_CALL_USD=0
GEO_PERPLEXITY_CALL_USD=0
GEO_GROK_CALL_USD=0
GEO_DEEPSEEK_CALL_USD=0
# Set only if reverse proxy validates/overwrites CF-Connecting-IP.
GEO_TRUST_CF_IP=0
