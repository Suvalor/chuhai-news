# 复制为 .env 后填写。生成随机值：openssl rand -hex 24
ADMIN_PASSWORD=
WEBHOOK_SECRET=
# 可选：MCP 写入工具的独立令牌，不设则沿用 WEBHOOK_SECRET
MCP_WRITE_TOKEN=
SECRET_KEY=
SITE_URL=https://你的域名
# 关于页公开的删除/更正联系邮箱；不设则关于页不显示联系方式
CONTACT_EMAIL=
# IndexNow 密钥（8–128 位字母数字或 -，可用 openssl rand -hex 16 生成）；设置后发布、修改、下架会通知 Bing 等搜索引擎
INDEXNOW_KEY=
